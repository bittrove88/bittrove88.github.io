<script>
'use strict';
(() => {
 const data=JSON.parse(document.getElementById('character-data').textContent), records=data.records, byId=new Map(records.map(r=>[r.id,r]));
 const $=id=>document.getElementById(id), svgNS='http://www.w3.org/2000/svg';
 const state={role:'',query:'',stage:'',category:'',imagesOnly:false}, pages={players:0,enemies:0}, pageSize=36;
 let filtered=[], current=null, focusView=false, opener=null, clipCounter=0;
 const lazyImages='IntersectionObserver' in window?new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){const img=entry.target.querySelector('image[data-src]');if(img){img.setAttribute('href',img.dataset.src);delete img.dataset.src;}lazyImages.unobserve(entry.target);}}},{rootMargin:'300px'}):null;
 const roleOrder=['ARC・ジョブ','旧自機','強敵の比較案','大ボス','中ボス','通常敵','未生成の発想'];
 const roleLabel=role=>role==='強敵の比較案'?'個性敵キャラ':role==='player'?'プレイヤー':role;
 const isPlayer=r=>r.role==='ARC・ジョブ'||r.role==='旧自機';
 const orderedRecords=[...records].sort((a,b)=>roleOrder.indexOf(a.role)-roleOrder.indexOf(b.role)||a.id.localeCompare(b.id));
 function resetPages(){pages.players=0;pages.enemies=0;}
 function el(tag,cls,text){const n=document.createElement(tag);if(cls)n.className=cls;if(text!==undefined)n.textContent=text;return n;}
 function imageOf(r){return r.image?{src:r.image,width:r.width,height:r.height}:null;}
 function box(r,focus){const im=imageOf(r);if(!im)return [0,0,1,1];const b=focus?r.region:[0,0,1,1];return [b[0]*im.width,b[1]*im.height,b[2]*im.width,b[3]*im.height];}
 function picture(r,focus,defer=false){const im=imageOf(r);if(!im)return null;const svg=document.createElementNS(svgNS,'svg'),bounds=box(r,focus),clipId='art-clip-'+(++clipCounter);svg.setAttribute('viewBox',bounds.join(' '));svg.setAttribute('role','img');svg.setAttribute('aria-label',r.name+' '+r.legacy);svg.setAttribute('preserveAspectRatio','xMidYMid meet');const defs=document.createElementNS(svgNS,'defs'),clip=document.createElementNS(svgNS,'clipPath'),rect=document.createElementNS(svgNS,'rect');clip.id=clipId;for(const [i,key] of ['x','y','width','height'].entries())rect.setAttribute(key,bounds[i]);clip.append(rect);defs.append(clip);svg.append(defs);const img=document.createElementNS(svgNS,'image');if(defer&&lazyImages)img.dataset.src=im.src;else img.setAttribute('href',im.src);img.setAttribute('width',im.width);img.setAttribute('height',im.height);img.setAttribute('clip-path','url(#'+clipId+')');svg.append(img);if(defer&&lazyImages)lazyImages.observe(svg);return svg;}
 function missing(r){const n=el('div','missing-art');n.append(el('span','placeholder-icon','◇'),el('strong','',r.uploadSlot?'原画ファイル未保存':'画像未生成'),el('span','',r.uploadSlot?'設定資料は確認できます':'発想を文章で記録しています'));return n;}
 function displayName(r){return r.name==='名称未定'?r.idea.split('／')[0]:r.name.replace('（仮称）','');}
 function family(r){const m=r.legacy.match(/^([NMB]\d{2})/);if(m)return m[1];const a=r.legacy.match(/^外観比較 (\d+)/);if(a)return 'APPEARANCE-'+a[1];const f=r.legacy.match(/^造形比較 (\d+)/);if(f)return 'FORM-'+f[1];if(r.uploadSlot)return 'ARC';return r.name;}
 function setStats(){const count=records.filter(r=>imageOf(r)).length;$('stat-records').textContent=records.length;$('stat-images').textContent=count;$('stat-originals').textContent=data.stats.originalImages;}
 function roleButtons(){const area=$('roles');area.replaceChildren();for(const role of ['','player',...roleOrder]){const b=el('button','role',roleLabel(role)||'すべて');b.type='button';b.dataset.role=role;b.setAttribute('aria-pressed',String(role===state.role));b.append(el('small','',role?records.filter(r=>role==='player'?isPlayer(r):r.role===role).length:records.length));b.addEventListener('click',()=>{state.role=role;resetPages();roleButtons();render();});area.append(b);}}
 function card(r){const n=el('article','card');n.dataset.id=r.id;const imageButton=el('button','art-button');imageButton.type='button';imageButton.setAttribute('aria-label',r.id+' '+displayName(r)+'の原画と設定を開く');const img=picture(r,true,true);imageButton.append(img||missing(r));if(img){imageButton.append(el('span','zoom-hint','原画と設定 ↗'));}imageButton.addEventListener('click',()=>open(r.id,imageButton));n.append(imageButton);const main=el('div','card-main'),meta=el('div','card-meta');meta.append(el('span','serial',r.id),el('span','tag',roleLabel(r.role)));main.append(meta,el('h4','',displayName(r)),el('p','legacy',r.legacy),el('p','concept',r.idea),el('p','shape',r.shape));n.append(main);const footer=el('div','card-footer');footer.append(el('span','',r.stage));const b=el('button','','詳細を見る');b.type='button';b.addEventListener('click',()=>open(r.id,b));footer.append(b);n.append(footer);return n;}
 function renderCollection(key,list){
  const totalPages=Math.max(1,Math.ceil(list.length/pageSize));
  pages[key]=Math.min(pages[key],totalPages-1);
  const start=pages[key]*pageSize,shown=list.slice(start,start+pageSize),groups=[];
  for(const role of roleOrder){
   const rows=shown.filter(r=>r.role===role);if(!rows.length)continue;
   const group=el('section','role-group'),title=el('h3','',roleLabel(role));
   title.id=key+'-role-'+roleOrder.indexOf(role);group.setAttribute('aria-labelledby',title.id);
   title.append(el('small','',list.filter(r=>r.role===role).length+' 記録'));
   const grid=el('div','grid');grid.append(...rows.map(card));group.append(title,grid);groups.push(group);
  }
  $(key+'-cards').replaceChildren(...groups);
  $(key).hidden=!list.length;
  $(key+'-count').textContent=list.length?`${start+1}–${start+shown.length} / ${list.length} 記録`:'';
  $(key+'-page').textContent=`${pages[key]+1} / ${totalPages}`;
  $(key+'-prev').disabled=pages[key]===0;$(key+'-next').disabled=pages[key]>=totalPages-1;
  $(key+'-pagination').hidden=totalPages===1;
 }
 function render(){
  if(lazyImages)lazyImages.disconnect();
  const q=state.query.normalize('NFKC').toLocaleLowerCase();
  filtered=orderedRecords.filter(r=>(!state.role||(state.role==='player'?isPlayer(r):r.role===state.role))&&(!state.stage||r.stage===state.stage)&&(!state.category||r.category===state.category)&&(!state.imagesOnly||imageOf(r))&&(!q||[r.id,r.name,r.legacy,roleLabel(r.role),r.idea,r.shape,r.category,r.phase,r.status].join(' ').normalize('NFKC').toLocaleLowerCase().includes(q)));
  const players=filtered.filter(isPlayer),enemies=filtered.filter(r=>!isPlayer(r));
  renderCollection('players',players);renderCollection('enemies',enemies);
  $('empty').hidden=filtered.length!==0;$('cards').hidden=filtered.length===0;
  $('result-count').textContent=`${filtered.length} 記録（プレイヤー ${players.length} ／ 敵キャラ ${enemies.length}）`;
  document.querySelectorAll('.collection-jumps a').forEach(a=>{a.hidden=!$(a.hash.slice(1))||$(a.hash.slice(1)).hidden;});
 }
 function reset(){Object.assign(state,{role:'',query:'',stage:'',category:'',imagesOnly:false});resetPages();$('query').value='';$('stage').value='';$('category').value='';$('images-only').checked=false;roleButtons();render();}
 function navigationList(r){const list=filtered.some(v=>v.id===r.id)?filtered:orderedRecords;return list.filter(v=>isPlayer(v)===isPlayer(r));}
 function renderViewer(){const r=current,im=imageOf(r);$('viewer').replaceChildren(im?picture(r,focusView):missing(r));$('view-full').setAttribute('aria-pressed',String(!focusView));$('view-focus').setAttribute('aria-pressed',String(focusView));$('view-focus').disabled=!im;$('view-full').disabled=!im;$('open-original').hidden=!im;$('open-original').href=im?im.src:'#';$('viewer-note').textContent=im?(r.position||'単独原画'):'この発想には生成画像がありません。';}
 function detailNav(delta){const list=navigationList(current);const index=list.findIndex(r=>r.id===current.id),target=list[index+delta];if(target)open(target.id);}
 function open(id,from){const r=byId.get(id);if(!r)return;current=r;focusView=false;if(from)opener=from;$('detail-id').textContent=r.id+' / '+r.legacy;$('detail-name').textContent=displayName(r);$('detail-tags').replaceChildren(el('span','tag',roleLabel(r.role)),el('span','tag',r.category),el('span','tag',r.stage));for(const key of ['idea','shape','review'])$('detail-'+key).textContent=r[key];$('detail-phase').textContent=r.phase+'\n'+r.status;const related=records.filter(v=>family(v)===family(r));$('related').replaceChildren(...related.map(v=>{const b=el('button',v.id===id?'current':'',v.id+' '+v.legacy);b.type='button';b.addEventListener('click',()=>open(v.id));return b;}));$('detail-links').replaceChildren(...r.sourceLinks.map(s=>{const a=el('a','',s.label);a.href=s.path;a.target='_blank';a.rel='noopener';return a;}));if(!r.sourceLinks.length)$('detail-links').append(el('span','','会話の記録による企画です。'));$('job-info').hidden=!r.job;$('job-info').replaceChildren();if(r.job){$('job-info').append(el('strong','','現行のジョブ設定'),el('p','','ジョブ技：'+r.job.skill),el('p','','必殺技：'+r.job.ultimate),el('p','',r.job.caption));}renderViewer();const list=navigationList(r),index=list.findIndex(v=>v.id===id);$('prev-detail').disabled=index===0;$('next-detail').disabled=index===list.length-1;if(!$('detail').open)$('detail').showModal();document.body.style.overflow='hidden';history.replaceState(null,'','#'+id);}
 function close(){if($('detail').open)$('detail').close();}
 $('close-detail').addEventListener('click',close);$('detail').addEventListener('click',e=>{if(e.target===$('detail')){const b=$('detail').getBoundingClientRect();if(e.clientX<b.left||e.clientX>b.right||e.clientY<b.top||e.clientY>b.bottom)close();}});$('detail').addEventListener('close',()=>{document.body.style.overflow='';history.replaceState(null,'',location.pathname+location.search);if(opener&&opener.isConnected)opener.focus();});$('detail').addEventListener('keydown',e=>{if(e.key==='ArrowLeft'){e.preventDefault();detailNav(-1);}if(e.key==='ArrowRight'){e.preventDefault();detailNav(1);}});
 $('view-full').addEventListener('click',()=>{focusView=false;renderViewer();});$('view-focus').addEventListener('click',()=>{focusView=true;renderViewer();});$('prev-detail').addEventListener('click',()=>detailNav(-1));$('next-detail').addEventListener('click',()=>detailNav(1));
 $('query').addEventListener('input',e=>{state.query=e.target.value;resetPages();render();});for(const key of ['stage','category'])$(key).addEventListener('change',e=>{state[key]=e.target.value;resetPages();render();});$('images-only').addEventListener('change',e=>{state.imagesOnly=e.target.checked;resetPages();render();});$('reset').addEventListener('click',reset);$('empty-reset').addEventListener('click',reset);for(const key of ['players','enemies'])for(const [suffix,delta] of [['prev',-1],['next',1]])$(key+'-'+suffix).addEventListener('click',()=>{pages[key]+=delta;render();$(key).scrollIntoView({block:'start',behavior:'auto'});});

 for(const category of [...new Set(records.map(r=>r.category))]){const o=el('option','',category);o.value=category;$('category').append(o);}
 roleButtons();setStats();render();const initial=location.hash.slice(1);if(byId.has(initial))open(initial);window.addEventListener('hashchange',()=>{const id=location.hash.slice(1);if(byId.has(id))open(id);else close();});
})();
</script>
</body>
</html>
