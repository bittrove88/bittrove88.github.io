  "descriptions": {
    "controls": {
      "title": "HOLD · RELEASE",
      "instruction": "Hold FIRE on the right; move and aim on the left.",
      "outcome": "Release FIRE to launch from your current position.",
      "context": "CONTROL"
    },
    "aim": {
      "title": "AIM ON THE LEFT",
      "instruction": "Use the inner stick on the left to adjust the angle.",
      "outcome": "Release the aim stick to keep your angle.",
      "context": "CONTROL"
    },
    "move": {
      "title": "MOVE WHILE CHARGING",
      "instruction": "Hold FIRE; use the outer left stick to move.",
      "outcome": "Stop moving and adjust aim without releasing FIRE.",
      "context": "CONTROL"
    },
    "slope": {
      "title": "MOVE",
      "instruction": "Push the left stick sideways.",
      "outcome": "Move onto a better firing slope.",
      "context": "THIS LEVEL"
    },
    "height": {
      "title": "HIGH GROUND",
      "instruction": "Move onto the higher ground.",
      "outcome": "Position changes your firing angle.",
      "context": "THIS LEVEL"
    },
    "pickup": {
      "title": "COLLECT",
      "instruction": "Hit the glowing capsule.",
      "outcome": "The item is saved immediately.",
      "context": "THIS LEVEL"
    },
    "reflection": {
      "title": "REFLECTIVE GROUND",
      "instruction": "Aim into the bright ground.",
      "outcome": "The shot bounces upward.",
      "context": "THIS LEVEL"
    },
    "B": {
      "title": "MOVING GATE",
      "instruction": "Watch the gate before firing.",
      "outcome": "The same shot changes when it moves.",
      "context": "THIS LEVEL"
    },
    "roof": {
      "title": "MIRRORED EAVE",
      "instruction": "Aim at the bright underside of the eave.",
      "outcome": "The mirror sends the shot downward.",
      "context": "THIS LEVEL"
    },
    "C": {
      "title": "CLOUD",
      "instruction": "Send a shot through the cloud.",
      "outcome": "The cloud slows the shot.",
      "context": "THIS LEVEL"
    },
    "K": {
      "title": "MIRROR",
      "instruction": "Aim at the bright mirror.",
      "outcome": "The shot turns at the mirror.",
      "context": "THIS LEVEL"
    },
    "U": {
      "title": "UPDRAFT",
      "instruction": "Send a shot into the rising air.",
      "outcome": "The air lifts the shot.",
      "context": "THIS LEVEL"
    },
    "F": {
      "title": "WIND",
      "instruction": "Fire through the moving air.",
      "outcome": "Wind carries the shot sideways.",
      "context": "THIS LEVEL"
    },
    "V": {
      "title": "VENT",
      "instruction": "Compare the vent on and off.",
      "outcome": "The same shot rises only when on.",
      "context": "THIS LEVEL"
    },
    "M": {
      "title": "MAGNETIC FIELD",
      "instruction": "Send a shot through the field.",
      "outcome": "The field bends its path.",
      "context": "THIS LEVEL"
    },
    "terminal": {
      "title": "FIELD SWITCH",
      "instruction": "Hit the glowing switch.",
      "outcome": "The field reverses next turn.",
      "context": "THIS LEVEL"
    },
    "boss-core": {
      "title": "BOSS ARMOR",
      "instruction": "Break a bright outer part.",
      "outcome": "Then hit the exposed core.",
      "context": "BOSS DEMO"
    },
    "boss-swap": {
      "title": "TURN THE CORE",
      "instruction": "Select SWAP, then hit the boss.",
      "outcome": "The core turns toward you.",
      "context": "BOSS DEMO"
    },
    "BURST": {
      "title": "BURST",
      "instruction": "Select BURST before firing.",
      "outcome": "The wider blast reaches the rival.",
      "context": "SKILL DEMO"
    },
    "BLINK": {
      "title": "BLINK",
      "instruction": "Select BLINK, then tap a landing twice.",
      "outcome": "The rover moves to that landing.",
      "context": "SKILL DEMO"
    },
    "PUSH": {
      "title": "PUSH",
      "instruction": "Select PUSH, then hit the rival.",
      "outcome": "The rival moves farther away.",
      "context": "SKILL DEMO"
    },
    "PULL": {
      "title": "PULL",
      "instruction": "Select PULL, then hit the rival.",
      "outcome": "The rival moves closer.",
      "context": "SKILL DEMO"
    },
    "BOUNCE": {
      "title": "BOUNCE",
      "instruction": "Select BOUNCE before firing.",
      "outcome": "The shot gains an extra bounce.",
      "context": "SKILL DEMO"
    },
    "SPLIT": {
      "title": "SPLIT",
      "instruction": "Select SPLIT before firing.",
      "outcome": "The shot separates at its highest point.",
      "context": "SKILL DEMO"
    },
    "PHASE": {
      "title": "PHASE",
      "instruction": "Select PHASE, then aim through the wall.",
      "outcome": "The shot passes through thin cover.",
      "context": "SKILL DEMO"
    },
    "SWAP": {
      "title": "SWAP",
      "instruction": "Select SWAP, then hit the rival.",
      "outcome": "Both rovers exchange positions.",
      "context": "SKILL DEMO"
    },
    "W01": {
      "title": "Standard",
      "instruction": "Hold FIRE, then release.",
      "outcome": "A single arcing shot.",
      "context": "WEAPON DEMO"
    },
    "W02": {
      "title": "Heavy Shell",
      "instruction": "Aim near the rival.",
      "outcome": "A wider blast reaches farther.",
      "context": "WEAPON DEMO"
    },
    "W03": {
      "title": "Needle",
      "instruction": "Aim directly toward the rival.",
      "outcome": "A fast, narrow shot.",
      "context": "WEAPON DEMO"
    },
    "W04": {
      "title": "Mortar",
      "instruction": "Raise the barrel above 55°.",
      "outcome": "A high arc drops over cover.",
      "context": "WEAPON DEMO"
    },
    "W05": {
      "title": "Hopper",
      "instruction": "Aim at the ground before the rival.",
      "outcome": "One hop carries the shot onward.",
      "context": "WEAPON DEMO"
    },
    "W06": {
      "title": "Ricochet",
      "instruction": "Bounce toward the rival.",
      "outcome": "The shot rebounds twice.",
      "context": "WEAPON DEMO"
    },
    "W07": {
      "title": "Roller",
      "instruction": "Land on the ground before the rival.",
      "outcome": "The shot rolls into the rival.",
      "context": "WEAPON DEMO"
    },
    "W08": {
      "title": "Skipper",
      "instruction": "Aim low at reflective ground.",
      "outcome": "Several low skips carry the shot.",
      "context": "WEAPON DEMO"
    },
    "W09": {
      "title": "Fan Shot",
      "instruction": "Aim the spread toward the rival.",
      "outcome": "Three shots leave in different directions.",
      "context": "WEAPON DEMO"
    },
    "W10": {
      "title": "Cluster",
      "instruction": "Aim above the rival.",
      "outcome": "The shot splits at its highest point.",
      "context": "WEAPON DEMO"
    },
    "W11": {
      "title": "Twin",
      "instruction": "Aim once toward the rival.",
      "outcome": "Two shots land one after the other.",
      "context": "WEAPON DEMO"
    },
    "W12": {
      "title": "Airburst",
      "instruction": "Send the shot near the rival.",
      "outcome": "The blast triggers in the air.",
      "context": "WEAPON DEMO"
    },
    "W13": {
      "title": "Drill",
      "instruction": "Aim through the thin wall.",
      "outcome": "The shot exits the cover and hits.",
      "context": "WEAPON DEMO"
    },
    "W14": {
      "title": "Rail",
      "instruction": "Aim straight at the rival.",
      "outcome": "A fast shot flies almost straight.",
      "context": "WEAPON DEMO"
    },
    "W15": {
      "title": "Archer",
      "instruction": "Aim above the rival.",
      "outcome": "The shot dives before impact.",
      "context": "WEAPON DEMO"
    },
    "W16": {
      "title": "Undercut",
      "instruction": "Land before the rival.",
      "outcome": "A ground wave reaches the rival.",
      "context": "WEAPON DEMO"
    },
    "W17": {
      "title": "Impact",
      "instruction": "Hit the rival.",
      "outcome": "The rival is pushed away.",
      "context": "WEAPON DEMO"
    },
    "W18": {
      "title": "Magnet",
      "instruction": "Hit the rival.",
      "outcome": "The rival is pulled closer.",
      "context": "WEAPON DEMO"
    },
    "W19": {
      "title": "Lifter",
      "instruction": "Hit below the rival.",
      "outcome": "The rival lands on a higher ledge.",
      "context": "WEAPON DEMO"
    },
    "W20": {
      "title": "Pinball",
      "instruction": "Bounce toward the rival.",
      "outcome": "Repeated rebounds push the rival away.",
      "context": "WEAPON DEMO"
    },
    "W": {
      "title": "REFLECTIVE GROUND",
      "instruction": "Aim into the bright ground.",
      "outcome": "The shot bounces upward.",
      "context": "THIS LEVEL"
    },
    "ceiling-lift": {
      "title": "LOW ROOF",
      "instruction": "Aim beneath the roof.",
      "outcome": "A low arc clears the cover.",
      "context": "THIS LEVEL"
    },
    "gate-choices": {
      "title": "MOVING GATE",
      "instruction": "Watch the gate before firing.",
      "outcome": "The same shot changes when it moves.",
      "context": "THIS LEVEL"
    },
    "touch-controls-v2": {
      "title": "FIRE",
      "instruction": "Hold FIRE, then release.",
      "outcome": "Release launches the shot.",
      "context": "CONTROL DEMO"
    },
    "teleport": {
      "title": "TELEPORT PROJECTILE",
      "instruction": "Select Teleport, aim and release FIRE.",
      "outcome": "Contact moves your rover. Landing ends your action.",
      "context": "CONTROL"
    },
    "wall-fall": {
      "title": "CONTACT · FALL · LAND",
      "instruction": "A teleport projectile hits the side of a wall.",
      "outcome": "Your rover drops straight down before the rival acts.",
      "context": "CONTROL"
    },
    "destruction": {
      "title": "OPEN THE PURPLE COVER",
      "instruction": "Shoot one cracked purple piece.",
      "outcome": "The opening remains for later shots.",
      "context": "LEVEL"
    },
    "choices": {
      "title": "CHOOSE A WAY THROUGH",
      "instruction": "Move by teleport, break cover, or use the open route.",
      "outcome": "Preparation costs an action; the rival still responds.",
      "context": "LEVEL"
    }
  }
}
