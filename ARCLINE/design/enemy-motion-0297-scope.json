          "before": "  s.time-=dt;if(s.time<=0&&cpuReady){if(cpuReady.action&&!E.commitEnemyAction(s,cpuReady.action)){cpuReady={target:s.units[1].x,plan:E.cpuPlan(s,E.seeded((s.matchSeed+s.round*1009)>>>0))};}if(cpuReady.action?.kind==='teleport'){cpuJob=null;cpuReady=null;s.phase='cpuTeleport';s.time=.55;tone(580,.25,'sine',.08);hud();return;}s.cpuTarget=cpuReady.target;s.cpuStart=s.units[1].x;s.cpuMoveTime=0;\n",
          "after": "  s.time-=dt;if(s.time<=0&&cpuReady){const teleport=cpuReady.action?.kind==='teleport';if(cpuReady.action&&!E.commitEnemyAction(teleport?{...s,units:s.units.map(u=>({...u}))}:s,cpuReady.action)){cpuReady={target:s.units[1].x,plan:E.cpuPlan(s,E.seeded((s.matchSeed+s.round*1009)>>>0))};}if(cpuReady.action?.kind==='teleport'){beginEnemyTeleport(cpuReady.action);hud();return;}s.cpuTarget=cpuReady.target;s.cpuStart=s.units[1].x;s.cpuMoveTime=0;\n"
