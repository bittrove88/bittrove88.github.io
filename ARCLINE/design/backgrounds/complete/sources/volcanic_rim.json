  "implementationNotes": {
    "canvas": "For rect/path, ctx.setTransform(w/1000,0,0,h/540,0,0) and ctx.fill(Path2D(d)); for circle, draw x scaled by w/1000, y by h/540 and r by min(w/1000,h/540).",
    "svg": "Use the same layer objects in order. No effects/filters or gradient defs.",
    "projectStatus": "Design assets committed to draft PR #75; not integrated with ARCLINE runtime"
  }
