    "quietCenter": {
      "rectNormalized": [
        0.28,
        0.27,
        0.45,
        0.5
      ],
      "purpose": "Do not add small high-contrast decorations here; projectile corridor"
    },
    "doNotUseAsActiveElementColor": [
      "#EBAA77",
      "#FAD8A9"
    ],
    "notes": "Do not draw fake platforms, aiming guides, glowing weapon-like streaks, or particles in gameplay corridor. Validate collision contours and all character/weapon colors in live client before approval."
