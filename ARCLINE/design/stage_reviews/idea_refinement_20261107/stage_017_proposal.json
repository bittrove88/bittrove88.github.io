  "design": {
    "core": "くぼみで下向きの入射を一回だけ返し、敵側の岩肩を越える。",
    "shape": "左の開いた発射岸、浅い鏡のくぼみ、右の岩肩と欠けた岩縁を一体にする。",
    "distinct": "一回反射を発見する初級面。複数の鏡選択や結晶・周期橋を加えない。",
    "roles": {
      "W": "下向きの弾を敵側へ返す。",
      "岩肩": "反射後に越える地盤の輪郭。登る・回る場合の支持面も持つ。",
      "欠けた岩縁": "右斜面に接続する任意の一片。開始側や鏡への入射を覆わない。"
    },
    "refinement": "浮いた上部岩を除去し、反射底を広げ、敵側を低い裾へ整理。狙いが鏡の角に偏らないよう入射面と着弾先を調整した。"
  },
