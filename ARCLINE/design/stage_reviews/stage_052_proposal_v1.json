  "summary": {
    "concept": "壊す窓を選んで洞内から撃つか、屋根へ出て天窓から落とす。",
    "terrain": "煙突と天窓のある連続した岩の観測廊",
    "widthReason": "洞内の準備区間、中央屋根、敵の天窓を分ける1180px。窓前までの移動を230pxに抑える。",
    "neighborDifference": "51面の開放尾根から、低い連続床と洞内の開口選択へ。53面の空隙を渡る攻略とは床の接続も準備の目的も異なる。"
  },
  "learningGoal": {
    "source": "下段から壁の細い窓を壊し、高い観測台の敵へ風の影響が短い射線を作る。",
    "proposed": "壊す窓を選んで洞内から撃つか、屋根へ出て天窓から落とす。",
    "decision": "発展"
  },
  "routeDesign": {
    "main": "窓前へ進み、上下二枚のうち射線に必要な窓を開ける。洞内の天井と短い風域を意識し、天窓下の敵へ低い弧を通す。",
    "alternative": "煙突の開口から中央屋根へ転移し、右の天窓から敵へ落とす。屋根に出るほど反撃を受けやすくなる。転移・落とし込みの入力は未検証。",
    "anchors": [
      {
        "id": "window",
        "x": 41,
        "h": 13,
        "surface": "floor0",
        "role": "窓前。開始から230px、歩行だけなら最低2ターン。"
      },
      {
        "id": "roof",
        "x": 74,
        "h": 43,
        "surface": "052-CENTRE-ROCK",
        "role": "天窓を狙う屋根上の転移候補。"
      }
    ],
    "setupActionsTarget": [
      1,
      3
    ],
    "totalActionsTarget": [
      7,
      12
    ],
    "budgetMeaning": "設計上の目標。クリア実績や保証ではない。歩行だけでなく窓破壊・転移と反撃を含めて実装時に確認する。",
    "gimmick": "Fは洞内の短い開口寄りに置き、風の滞在を短くする判断に意味を持たせる。窓は二個の独立破壊物、煙突の上部は固定。"
  },
