  "summary": {
    "concept": "垂直落差を使って底の鏡面へ落とし、破壊した窓から洞内の敵へ通す。",
    "terrain": "垂直氷壁の足元に広がる反射洞窟",
    "changeFromPrevious": "崖の最上部を削り、x27 h76からx41 h28まで緩やかではないが連続した斜面の氷壁肩に変更。出現点x14→崖肩x26を約120px歩くことで、射撃窓中央への仮想線が床に塞がれなくなる。洞窟天井F01・破壊窓D02の2独立単位・W/Fの作用領域・敵位置は維持。",
    "reviewAgainstCompendium": "崖の最上部を削り、x27 h76からx41 h28まで緩やかではないが連続した斜面の氷壁肩に変更。出現点x14→崖肩x26を約120px歩くことで、射撃窓中央への仮想線が床に塞がれなくなる。洞窟天井F01・破壊窓D02の2独立単位・W/Fの作用領域・敵位置は維持。"
  },
  "learningGoal": {
    "source": "高所から下段の氷壁窓を開き、水面を利用して低い敵へ届かせる。",
    "proposed": "垂直落差を使って底の鏡面へ落とし、破壊した窓から洞内の敵へ通す。",
    "decision": "発展"
  },
  "routeDesign": {
    "main": "自機は左上の安全な出現棚（x14）から崖肩A（x26）へ約120px歩く。斜めに削られた氷壁の肩で弾道の出入口が開き、D02窓の必要な片を破壊してから下段W反射で洞窟の敵を攻撃する。単なる開始位置からの一方的な射撃にしない。",
    "alternative": "開始地点から洞窟入口B（x54, h18.77）へテレポートし、D02の独立破壊片を狙って低い弾道で敵を攻撃する。入口射点は高所反射より敵に近く、反撃を受けやすい。",
    "anchors": [
      {
        "id": "upper",
        "x": 26,
        "h": 76,
        "surface": "floor0",
        "role": "上部斜面を削った崖肩。約120px歩くと想定直線が崖に遮られず、下段反射へ落とす射撃空間を確保する。",
        "plan": "main",
        "requiredMechanisms": [
          "bounce"
        ]
      },
      {
        "id": "entrance",
        "x": 54,
        "h": 18.769230769,
        "surface": "floor0",
        "role": "洞窟入口へ転移。窓を開けたのち低い弾道で洞内へ通す。",
        "plan": "alternative"
      }
    ],
    "benefits": [
      "上部斜面を削ったことで高所から発射可能な方向が広がり、前進の戦術的価値が生まれる",
      "下段W反射と洞口転移の別解の両方を保持する"
    ],
    "costs": [
      "高所の主攻略は徒歩と破壊が必要",
      "入口の別解は転移と開口作業が必要で敵に近い"
    ],
    "setupActionsTarget": [
      1,
      3
    ],
    "totalActionsTarget": [
      7,
      13
    ],
    "budgetMeaning": "Design target, not a measured clear. Includes preparing windows, teleport and exposure; no combat simulation performed.",
    "evidenceSequenceRequirement": "P0→移動/転移/破壊/切替→射点候補→作用ギミック→敵の実位置→単発弾道→残り手数。未測定項目は未検証として残す。",
    "accessEvidence": "崖肩への120px徒歩距離と、設計上の床遮蔽の解消を独立計算で確認。実ゲーム移動、実弾道、敵反撃、テレポート実着地はすべて再検証待ち。"
  },
