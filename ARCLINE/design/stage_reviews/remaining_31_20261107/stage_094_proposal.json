  "design": {
    "core": "右の高い構造材から雲を通して外板の一片へ落とすか、左船首へ回りWとMから逆向きに送る。",
    "change": "船首と鏡桁を一つの支持面へ統合。右の外板は二片のうち右一片だけを開く構想とした。",
    "distinct": "右開始から左向きに落とす経路と、敵の反対側へ渡って右向きに返す経路。雲の減速とW/Mを別の位置判断に結ぶ。",
    "inherit": {
      "terrain": "中央へ沈む湾曲滑走路と反対向きの背面射撃",
      "concept": "遠い棚に転移し、雲の外側から滑走路を横向きに狙う。",
      "alternative": "低い反射と磁場で背面へ送るか、敵の後方棚へ回り込む。"
    },
    "special": "外板全体を一片と扱わず右片@1だけを開く提案。左側は破壊を必須にしない。Cは弾減速のみで視線・反撃を遮断しない。船首の一体斜面以外に意図しないW支持面を作らない。"
  },
  "approval": {
    "state": "pending"
  },
